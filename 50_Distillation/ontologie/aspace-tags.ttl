aspace:tag-legacy          a skos:Concept ; skos:prefLabel "legacy"@fr ; skos:notation "legacy" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-statut .

# cartographie (3 narrowers)

aspace:tag-mapping         a skos:Concept ; skos:prefLabel "mapping"@fr ; skos:notation "mapping" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-cartographie .
