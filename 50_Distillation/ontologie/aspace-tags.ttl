aspace:tag-l0              a skos:Concept ; skos:prefLabel "L0 Tech OS"@fr ; skos:notation "l0" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-architecture .
aspace:tag-l1              a skos:Concept ; skos:prefLabel "L1 Life OS"@fr ; skos:notation "l1" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-architecture .
aspace:tag-life-os         a skos:Concept ; skos:prefLabel "Life OS"@fr ; skos:notation "life-os" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-architecture .
aspace:tag-business-os     a skos:Concept ; skos:prefLabel "Business OS"@fr ; skos:notation "business-os" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-architecture .
aspace:tag-governance      a skos:Concept ; skos:prefLabel "gouvernance"@fr ; skos:notation "governance" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-architecture .
aspace:tag-canon           a skos:Concept ; skos:prefLabel "canon"@fr ; skos:notation "canon" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-architecture .

# agent / persona (10 narrowers)

aspace:tag-a3              a skos:Concept ; skos:prefLabel "A3 Data"@fr ; skos:notation "a3" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-b1              a skos:Concept ; skos:prefLabel "B1 direction"@fr ; skos:notation "b1" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-b2              a skos:Concept ; skos:prefLabel "B2 meso"@fr ; skos:notation "b2" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-b3              a skos:Concept ; skos:prefLabel "B3 warp"@fr ; skos:notation "b3" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-spock           a skos:Concept ; skos:prefLabel "Spock Areas"@fr ; skos:notation "spock" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-beth            a skos:Concept ; skos:prefLabel "Beth Life"@fr ; skos:notation "beth" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-jerry           a skos:Concept ; skos:prefLabel "Jerry Business"@fr ; skos:notation "jerry" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-picard          a skos:Concept ; skos:prefLabel "Picard Projects"@fr ; skos:notation "picard" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-geordi          a skos:Concept ; skos:prefLabel "Geordi Resources"@fr ; skos:notation "geordi" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .
aspace:tag-cerritos        a skos:Concept ; skos:prefLabel "Cerritos GTD"@fr ; skos:notation "cerritos" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-agent-persona .

# artefact-type (6 narrowers)

aspace:tag-concept         a skos:Concept ; skos:prefLabel "concept (type)"@fr ; skos:notation "concept" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-artefact-type ; skos:scopeNote "Marqueur TYPE qui chevauche la classe aspace:Concept. Une entite tagguee 'concept' est censee etre un aspace:Concept — voir requetes.sparql pour verifier l'alignement."@fr .
aspace:tag-projet          a skos:Concept ; skos:prefLabel "projet"@fr ; skos:notation "projet" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-artefact-type .
aspace:tag-project         a skos:Concept ; skos:prefLabel "project (EN)"@fr ; skos:notation "project" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-artefact-type ; skos:relatedMatch aspace:tag-projet ; skos:scopeNote "Doublon linguistique de 'projet' (7). A fusionner dans une prochaine regeneration : remplacer 'project' (3) par 'projet' partout."@fr .
aspace:tag-doctrine        a skos:Concept ; skos:prefLabel "doctrine"@fr ; skos:notation "doctrine" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-artefact-type .
aspace:tag-adr             a skos:Concept ; skos:prefLabel "ADR"@fr ; skos:notation "adr" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-artefact-type .
aspace:tag-sdd             a skos:Concept ; skos:prefLabel "SDD"@fr ; skos:notation "sdd" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-artefact-type .

# domaine (3 narrowers)

aspace:tag-ld01            a skos:Concept ; skos:prefLabel "LD01 Business"@fr ; skos:notation "ld01" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-domaine .
aspace:tag-life-os-dom     a skos:Concept ; skos:prefLabel "Life OS (domaine)"@fr ; skos:notation "life-os" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-domaine ; skos:scopeNote "Le tag 'life-os' designe ici le life-domain L1 (Beth/Morty/6 vaisseaux), distinct de la couche architecture life-os."@fr .
aspace:tag-business-os-dom a skos:Concept ; skos:prefLabel "Business OS (domaine)"@fr ; skos:notation "business-os" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-domaine ; skos:scopeNote "Le tag 'business-os' designe ici le domaine metier L2, distinct de la couche architecture business-os. Meme notation, usage distinct selon le contexte — a clarifier dans une V0.2 du schema."@fr .

# connaissance (4 narrowers — les 4 piliers Geordi)

aspace:tag-kb              a skos:Concept ; skos:prefLabel "Knowledge Base"@fr ; skos:notation "kb" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-connaissance .
aspace:tag-okf             a skos:Concept ; skos:prefLabel "OKF"@fr ; skos:notation "okf" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-connaissance .
aspace:tag-wiki            a skos:Concept ; skos:prefLabel "Wiki"@fr ; skos:notation "wiki" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-connaissance .
aspace:tag-graphify        a skos:Concept ; skos:prefLabel "Graphify"@fr ; skos:notation "graphify" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-connaissance .

