# Ontologie A'Space OS — vocabulaire controle des tags (SKOS).
# Produit par minimax-m3 le 2026-08-17.
#
# Regle appliquee : la regle des trois occurrences. Sur 457 tags distincts
# dans le bundle au 2026-08-17, 39 apparaissent au moins 3 fois. Les 418
# autres n'apparaissent qu'une ou deux fois : ce ne sont pas des categories,
# ce sont des occurrences (et la majorite devraient disparaitre des tags
# une fois le vocabulaire controle en place).
#
# Les fusions : 'projet' (7) et 'project' (3) designent le meme concept ;
# on garde 'projet' et on redirige 'project' via skos:relatedMatch.

@prefix aspace:    <urn:aspace:ns:> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .

# ========================================================================
# 8 concepts-racines — la structure du vocabulaire controle
# ========================================================================

aspace:tag-methode
    a skos:Concept ;
    skos:prefLabel "methode"@fr ;
    skos:definition "Cadre methodologique d'execution ou d'organisation. Regroupe les methodes dotees d'un nom propre (PARA, GTD, Ikigai, Life Wheel, 12WY, DEAL) — toutes partagent le statut de 'grammaire canonique' du poste. La frontiere avec 'framework' : une methode est une procedure, un framework est une structure."@fr ;
    skos:notation "methode" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-architecture
    a skos:Concept ;
    skos:prefLabel "architecture"@fr ;
    skos:definition "Couche, structure, gouvernance. Regroupe les tags qui designent un niveau d'abstraction du systeme (L0 Tech OS / L1 Life OS / L2 Business OS), un registre de souverainete (governance, canon), ou une frontiere (matryoshka). La frontiere avec 'methode' : l'architecture decrit ou sont les choses, la methode dit quoi en faire."@fr ;
    skos:notation "architecture" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-agent-persona
    a skos:Concept ;
    skos:prefLabel "agent / persona"@fr ;
    skos:definition "Acteur canonique, role, officier. Regroupe les tags qui designent un agent A0-A3 (registre kernel), un officier (registre Star Trek : Picard/Spock/Geordi/Data/Cerritos), un hero-manager (B1-B3), ou un capitaine de domaine. La frontiere avec 'architecture' : un agent est un acteur, l'architecture est le decor."@fr ;
    skos:notation "agent-persona" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-artefact-type
    a skos:Concept ;
    skos:prefLabel "type d'artefact"@fr ;
    skos:definition "Nature du document ou du concept porte par le tag. Regroupe les tags qui designent un type de livrable (concept, projet, doctrine, ADR, SDD). La frontiere avec 'statut' : le type est permanent (un projet reste un projet), le statut evolue (un projet embryonnaire devient gradue)."@fr ;
    skos:notation "artefact-type" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-domaine
    a skos:Concept ;
    skos:prefLabel "domaine fonctionnel"@fr ;
    skos:definition "Registre d'activite, life-domain ou business-domain. Regroupe les tags qui designent une aire d'engagement (ld01 Business, business-os, life-os). La frontiere avec 'methode' : un domaine est un terrain, une methode est un outil qu'on y applique."@fr ;
    skos:notation "domaine" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-connaissance
    a skos:Concept ;
    skos:prefLabel "gestion de la connaissance"@fr ;
    skos:definition "Pilier ou outil de gestion de la base de connaissance (KB) : OKF (frontmatter canonique), Wiki (format LLM), Graphify (pipeline graphe), KB (racine). Quatre piliers canoniques du Geordi KB."@fr ;
    skos:notation "connaissance" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-statut
    a skos:Concept ;
    skos:prefLabel "statut"@fr ;
    skos:definition "Etat d'avancement ou cycle de vie. Regroupe les tags qui designent un etat (gradue, legacy, embryonnaire). La frontiere avec 'type d'artefact' : un statut est temporel, un type est permanent."@fr ;
    skos:notation "statut" ;
    skos:inScheme aspace:tag-scheme .

aspace:tag-cartographie
    a skos:Concept ;
    skos:prefLabel "cartographie / routage"@fr ;
    skos:definition "Mise en correspondance entre deux structures. Regroupe les tags qui designent une action de mapping (mapping, routing, classification) — l'operation qui prend une structure A et la projette sur une structure B."@fr ;
    skos:notation "cartographie" ;
    skos:inScheme aspace:tag-scheme .

# Concept-racine dedie au bundle prompt-systeme (sa nomenclature propre)

aspace:tag-prompt-systeme
    a skos:Concept ;
    skos:prefLabel "section du prompt systeme"@fr ;
    skos:definition "Section du prompt systeme telle que structuree dans le bundle 60_Implementation_Methodologiques. Les sous-tags sont les 7 sections canoniques : purpose, alias, points-de-reference, bornes-operationnelles, patterns-positifs-negatifs, exemples-distillation-contexte, regle-multiplicativite. Statut a part : ce tag designe une section formelle du systeme, pas un theme."@fr ;
    skos:notation "prompt-systeme" ;
    skos:inScheme aspace:tag-scheme .

# ========================================================================
# 39 narrower concepts — application de la regle des trois occurrences
# ========================================================================

# methode (7 narrowers)

aspace:tag-para            a skos:Concept ; skos:prefLabel "PARA"@fr ; skos:notation "para" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-methode .
aspace:tag-gtd             a skos:Concept ; skos:prefLabel "GTD"@fr ; skos:notation "gtd" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-methode .
aspace:tag-ikigai          a skos:Concept ; skos:prefLabel "Ikigai"@fr ; skos:notation "ikigai" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-methode .
aspace:tag-life-wheel      a skos:Concept ; skos:prefLabel "Life Wheel"@fr ; skos:notation "life-wheel" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-methode .
aspace:tag-12wy            a skos:Concept ; skos:prefLabel "12 Weeks Year"@fr ; skos:notation "12wy" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-methode .
aspace:tag-deal            a skos:Concept ; skos:prefLabel "DEAL"@fr ; skos:notation "deal" ; skos:inScheme aspace:tag-scheme ; skos:broader aspace:tag-methode ; skos:scopeNote "Tag present 1-2 fois dans le bundle mais deja vu dans la litterature source ; garde ici pour anticipation."@fr .

