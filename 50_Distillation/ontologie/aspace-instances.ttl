    aspace:verifiePar "process:lecture-canon" ;
    dcterms:source "C:/Users/amado/.claude/CLAUDE.md" ;
    dcterms:source "C:/Users/amado/CLAUDE.md" ;
    rdfs:label "Pourquoi urn:aspace:ns: — un namespace qui ne prétend rien" .

<urn:aspace:concept:ontologie:_concepts_ontologie_predicats>
    a aspace:Concept ;
    aspace:bundle "ontologie" ;
    aspace:fichier "50_Distillation//ontologie//_concepts_ontologie_predicats.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Pourquoi 11 prédicats typés, pas un seul relatedTo" ;
    dcterms:description "Le constat : 129 relations, toutes aspace:relatedTo. Le schema propose 11 prédicats typés (instantiates, appliesTo, dependsOn, partOf, refines, supersedes, pairedWith, governs, cites, handledBy, seeAlso). Chaque prédicat est illustré par au moins deux relations réelles du graphe — règle du poste : un prédicat qui ne peut pas être illustré deux fois n'a pas lieu d'être." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "ontologie" ;
    aspace:tag "predicat" ;
    aspace:tag "relation" ;
    aspace:tag "semantique" ;
