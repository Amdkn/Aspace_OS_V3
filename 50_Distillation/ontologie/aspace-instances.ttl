<urn:aspace:concept:pulse-domaines:wonder-woman-revenue-concentration-risk-doctrine>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//wonder-woman//wonder-woman-revenue-concentration-risk-doctrine.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Revenue concentration risk — single client > 30% MRR, doctrine 3 seuils + couplage JohnJones/Flash" ;
    dcterms:description "Quand un client unique représente > 30% du MRR (Monthly Recurring Revenue), l'entreprise n'a pas un portefeuille — elle a un fournisseur déguisé en client. La doctrine Finance WW pose 3 seuils (warning 30%, escalation 50%, hard veto 70%) couplés à JohnJones (Sales) pour la diversification pipeline et Flash (Product) pour la diversification produit. L'asymétrie JohnJones (qui signe) vs Wonder Woman (qui alerte) : la diversification MRR est un **objectif Sales**, pas un veto Finance — WW Signale, ne bloque pas." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "wonder-woman" ;
    aspace:tag "finance" ;
    aspace:tag "revenue-concentration" ;
    aspace:tag "mrr" ;
