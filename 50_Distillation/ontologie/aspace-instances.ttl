<urn:aspace:concept:pulse-domaines:green-lantern-people-raci-transverse-jamais-A>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-raci-transverse-jamais-A.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "People — RACI transverse, jamais Accountable" ;
    dcterms:description "La position RACI de People (Green Lantern) sur le pair-check #9 *People → Tous* est unique : C (Consulted) systématiquement, jamais A (Accountable). Accountable est toujours le B2 captain du domaine impacté (Batman Ops, Superman Growth, etc.). Cette règle empêche People de devenir un arbitre transverse qui statue sur les autres domaines. Conséquence : People peut signaler un blocker de capacité, mais le trade-off final est rendu par le captain du domaine impacté ou par le Council." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "people" ;
    aspace:tag "green-lantern" ;
