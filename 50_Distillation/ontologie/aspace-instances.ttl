<urn:aspace:concept:pulse-domaines:superman-triple-signature-co-sponsorat-doctrine>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//superman//superman-triple-signature-co-sponsorat-doctrine.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Superman Growth — doctrine co-sponsorat triple-signature pour DoD attention cross-domaines" ;
    dcterms:description "Les cas-types 2 (awareness prelaunch) et 3 (SEO long-terme) du DoD attention vague 5 portent une triple-signature Superman + capitaine transverse + JohnJones. Superman formalise cette triple-signature en doctrine unilatérale de co-sponsorat Growth, applicable à tout DoD attention qui touche un capitaine transverse (People/Brand, Flash/Product, IT/Analytics) en aval de la transition. Doctrine distincte de l'amplification triplet 58 (concept companion) — celle-ci pose la **structure de signature** des DoD, pas l'horizon ROI." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "superman" ;
    aspace:tag "growth" ;
    aspace:tag "co-sponsorat" ;
    aspace:tag "triple-signature" ;
