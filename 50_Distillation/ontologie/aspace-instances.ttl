<urn:aspace:concept:pulse-domaines:green-lantern-people-gats-assigned-needs-owner-dlq>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-gats-assigned-needs-owner-dlq.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "People — trois gates émis, ASSIGNED / NEEDS_OWNER / DLQ" ;
    dcterms:description "People émet trois états B2 vers les autres domaines : ASSIGNED (owner valide, charge tenable, mandat vérifiable), NEEDS_OWNER (mandat posé mais owner vacant ou charge saturée), DLQ (pas d'owner possible, escalade B1 ou abandon du mandat). Chaque état a un déclencheur vérifiable et un couplage avec le veto People. Le mapping avec les 8 gates des autres domaines révèle un sous-ensemble commun mais une asymétrie : People est le seul à pouvoir émettre DLQ sans veto externe." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "people" ;
    aspace:tag "green-lantern" ;
    aspace:tag "gates" ;
    aspace:tag "assigned" ;
