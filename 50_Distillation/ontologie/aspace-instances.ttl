<urn:aspace:concept:pulse-b3:b3-hole-signaling-doctrine>
    a aspace:Concept ;
    aspace:bundle "pulse/b3" ;
    aspace:fichier "70_Onthologies//pulse//b3//b3-hole-signaling-doctrine.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "B3 hole-signaling — un B3 qui trouve un trou ne le comble pas, il le signale" ;
    dcterms:description "Étend au B3 l'invariant Coach OS « interdire de combler un trou du sprint ». Un trou de paquet (champ manquant, dépendance non résolue, hypothèse non vérifiable) n'est jamais comblé en silence par le B3 : il est signalé en format canonique 4 champs (location, kind, impact, suggested_fix). Le trou devient un objet de signalement, pas une décision invisible." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b3" ;
    aspace:tag "hole" ;
