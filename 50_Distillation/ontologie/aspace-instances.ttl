<urn:aspace:concept:pulse-domaines:batman-doctrine-remonte-volume-amont-0-cas-observed>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-doctrine-remonte-volume-amont-0-cas-observed.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Doctrine remonte volume amont — protocole d'observation à 0 cas" ;
    dcterms:description "La doctrine Batman « remonte à Summers des faits, pas des décisions » (triplets 56/57) est étendue en tour 3 au volume (trigger charge_derivee). 0 cas observé en cycle. Le présent protocole formalise l'observation : infrastructure minimum (compteur, journal, seuil), conditions de declenchement, periodicité de revue, asymétrie trigger vs seuil fixe." ;
    aspace:okfVersion "0.2" ;
