    aspace:kind kind:Concept ;
    dcterms:title "Pourquoi la règle des trois occurrences — un tag seul n'est pas une catégorie" ;
    dcterms:description "Le constat : 457 tags distincts pour 95 concepts, 39 seulement apparaissent 3 fois ou plus, 418 une ou deux fois. La règle du poste : en dessous de trois occurrences, ce n'est pas une catégorie, c'est une occurrence. Cette règle transforme un bruit de 457 en un vocabulaire contrôlé de 39 organisé en 9 racines SKOS." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "ontologie" ;
    aspace:tag "tags" ;
    aspace:tag "skos" ;
    aspace:tag "vocabulaire" ;
    aspace:tag "seuil" ;
    aspace:niveauConfiance aspace:confirmeMachine ;
    aspace:generePar "minimax-m3" ;
    aspace:verifiePar "process:comptage-tags" ;
    dcterms:source "C:/Users/amado/ASpace_OS_V3/50_Distillation/ontologie/vocabulaire_mesure.json" ;
    rdfs:label "Pourquoi la règle des trois occurrences — un tag seul n'est pas une catégorie" .

