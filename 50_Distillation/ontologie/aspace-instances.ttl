<urn:aspace:concept:pulse-domaines:johnjones-table-8x5-extension-forcage-zero-council-submission>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//john-jones//johnjones-table-8x5-extension-forcage-zero-council-submission.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "JohnJones — proposition Council-ready extension table 8×4 Superman NEEDS_SIGNAL avec 5ᵉ état « forçage zéro » Sales" ;
    dcterms:description "Ferme l'ouverture tour 4 R6 (doctrine forçage zéro 4ᵉ état Sales doit être intégrée à la table 8×4 Superman) en un packet mésoperpétuel Council-ready. Superman tour 3 a posé la table 8-domain × 4 états (READY/NEEDS_SIGNAL/BLOCKED/DORMANT). Pour JohnJones, forçage zéro est un 5ᵉ état qui complète la table. Le concept pose l'extension 8×5 (ou 8×4+1 colonne), les 4 cas d'application, les 3 cas d'abus, et la procédure d'adoption 5/8 (vs unanimité 8/8)." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b2" ;
    aspace:tag "johnjones" ;
    aspace:tag "sales" ;
    aspace:tag "superman" ;
