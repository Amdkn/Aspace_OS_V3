<urn:aspace:concept:pulse-domaines:wonder-woman-squad-lead-thunderbolts-mandate-spec>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//wonder-woman//wonder-woman-squad-lead-thunderbolts-mandate-spec.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Squad lead Thunderbolts — Yelena Belova mandat H30 orchestrateur Finance" ;
    dcterms:description "Le squad lead de Thunderbolts (squad Finance B3) n'est pas posé canoniquement comme CaptainAmerica l'est pour Avengers. Les 6 agents canoniques (Bucky, Yelena, Red Guardian, Ghost, Taskmaster, U.S. Agent) sont posés, le 7ᵉ reste projeté, et le rôle de squad lead orchestrateur (tenue scrums.md, signalement trous, preuve 4 formes, double signature B2→B3, aggregation gate) n'est pas assigné. Yelena Belova est la candidate principale par lecture cohérente avec son rôle de productrice (concept 23 F2 pessimistic forecasting) — fiche roster YAML Council-ready proposée." ;
    aspace:okfVersion "0.2" ;
