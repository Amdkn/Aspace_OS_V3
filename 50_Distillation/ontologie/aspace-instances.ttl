<urn:aspace:concept:pulse-domaines:wonder-woman-survival-protocol-3-month-runway>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//wonder-woman//wonder-woman-survival-protocol-3-month-runway.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Survival protocol — séquence 4 actions quand runway < 3 mois (black phase F1)" ;
    dcterms:description "Quand le runway passe < 3 mois (black phase F1, cf. concept f1-runway), Wonder Woman déclenche un protocole de survie en 4 actions séquentielles : (1) gel des dépenses non-essentielles sous 24h, (2) communication transparente à l'équipe sous 48h, (3) plan de continuité 90 jours avec réduction opex ≥ 30%, (4) escalation B1 par escalier canonique 5 échelons. Ce protocole comble le trou entre le seuil runway < 6 mois (red flag #4) et le seuil runway < 3 mois (escalade B1 Summers). Il est symétrique aux protocoles Batman (condition d'arrêt procedure) et Superman (promesse delivery)." ;
    aspace:okfVersion "0.2" ;
