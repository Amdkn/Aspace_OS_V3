<urn:aspace:concept:pulse-domaines:batman-anti-pattern-2-charges-implicites-fantastic-four-procedure-reouverture>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-anti-pattern-2-charges-implicites-fantastic-four-procedure-reouverture.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "2 charges B3 implicites Fantastic Four — procédure de ré-ouverture" ;
    dcterms:description "Depuis 5 tours, Batman signale que 2 agents sur 4 (InvisibleWoman, TheThing) n'ont pas de charge documentée. Le triplet 41 interdit à B3 de combler un trou ; le triplet 56 interdit à Batman de décider. La question « qui pose les charges » est un trou canonique. Ce concept propose une procédure en 4 étapes (intake → désignation squad lead → revue 7 jours → append roster) impliquant Batman (fait), Green Lantern (décision People), MrFantastic (squad lead consultation), et le B1 (ratification si intersquad)." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "batman" ;
    aspace:tag "fantastic-four" ;
