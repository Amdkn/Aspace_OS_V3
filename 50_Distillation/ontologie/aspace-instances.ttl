<urn:aspace:concept:pulse-domaines:green-lantern-people-recompte-53-roster-issue-a-council-submission>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-recompte-53-roster-issue-a-council-submission.md" ;
