<urn:aspace:concept:pulse-domaines:johnjones-doctrine-e-myth-manager-formalisee>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//john-jones//johnjones-doctrine-e-myth-manager-formalisee.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "JohnJones — doctrine E-Myth Manager formalisée pour le captain Sales (alloue, ne porte pas)" ;
    dcterms:description "VP_SOUL.md pose la métaphore « le télépathe — lire l'état mental de l'acheteur avant de parler prix » comme attribut du captain JohnJones. Mais la doctrine E-Myth Manager (cf. Ownerbook T1 via 8-domain wheel) pose que le captain ne fait pas le geste du technicien. La lecture cognitive est une charge ProfessorX (B3 squad Illuminati), pas un attribut capitaine. Formaliser cette doctrine pour Sales comble un gap identifié dans le rapport vague 2 (cf. RAPPORT_dom-john-jones.md §6)." ;
    aspace:okfVersion "0.2" ;
