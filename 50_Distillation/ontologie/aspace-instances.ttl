<urn:aspace:concept:pulse-domaines:green-lantern-people-dormance-attente-active>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-dormance-attente-active.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "People — dormance vs attente vs actif, trois états et leurs déclencheurs" ;
    dcterms:description "Le canon B2 pose la doctrine de dormance pour les domaines B2 sans mandate B1 actif, mais ne distingue pas l'attente (signal en attente de B1) de la dormance (silence durable). Le concept propose trois états People — DORMANT, EN_ATTENTE, ACTIF — avec leurs déclencheurs d'entrée et de sortie, et un cas asymétrique pour People × IT (skills L0) qui ne tombe jamais en dormance complète. Reconstruit, à arbitrer par B2 Council." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "people" ;
