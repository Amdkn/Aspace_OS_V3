<urn:aspace:concept:pulse-domaines:wonder-woman-pair-check-consulted-role>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//wonder-woman//wonder-woman-pair-check-consulted-role.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Wonder Woman en C — pourquoi Finance est Consulted et pas Accountable sur les pair-checks #5 et #6" ;
    dcterms:description "Le RACI par rang positionne Wonder Woman en C (Consulted) sur les pair-checks #5 (Finance→Growth) et #6 (Finance→Product). Ce n'est pas une faiblesse — c'est la conséquence directe de la règle ADR-MESH-L2-001 (« un datum, un owner »). Wonder Woman arbitre la cohérence financière globale (pair-check #4 transpose au red flag), pas la handoff entre le domaine amont et le domaine aval. Son pouvoir A effectif vient du droit de blocage hard sur la marge négative, pas du RACI." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b2" ;
    aspace:tag "finance" ;
    aspace:tag "raci" ;
    aspace:tag "consulted" ;
