<urn:aspace:concept:pulse-b3:b3-cross-squad-dofld-protocol>
    a aspace:Concept ;
    aspace:bundle "pulse/b3" ;
    aspace:fichier "70_Onthologies//pulse//b3//b3-cross-squad-dofld-protocol.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "B3 cross-squad DOFLD — l'annuaire qui rend la sollicitation traçable" ;
    dcterms:description "Le DOFLD (Domain-Owner-Federated Lookup Dispatch) est l'annuaire qui permet à un B3 de trouver le bon pair cross-squad sans connaître tous les squads. Publié par chaque squad lead dans `01_B3_AGENT_ROSTER.md`, lu par les autres squads, format de lookup 4 champs, anti-patterns. Le DOFLD ne sert pas qu'à trouver : il rend la sollicitation visible au squad lead de l'agent ciblé." ;
    aspace:okfVersion "0.2" ;
