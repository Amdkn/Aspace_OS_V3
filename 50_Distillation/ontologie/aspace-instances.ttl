<urn:aspace:concept:pulse-domaines:batman-couplage-ops-it>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-couplage-ops-it.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Couplage Ops (Batman) ↔ IT (Cyborg) — la chaîne Product→IT→Ops" ;
    dcterms:description "Ops et IT sont les deux faces du red flag #1 — Product green, Ops/IT red. La frontière est nette : IT tient le système (déploiement, monitoring, récupération), Ops tient la procédure (runbook, escalation, condition d'arrêt). Mais la chaîne Product→IT→Ops traverse Batman deux fois (en A sur Product→Ops, et en dépendance côté IT). Le couplage Batman-Cyborg est ce qui ferme la porte de la livraison." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "batman" ;
    aspace:tag "cyborg" ;
    aspace:tag "ops" ;
