<urn:aspace:concept:pulse-domaines:aquaman-outside-counsel-management-fee-discipline>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//aquaman//aquaman-outside-counsel-management-fee-discipline.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Aquaman — Outside Counsel Management (couplage Aquaman × Wonder Woman sur honoraires juridiques)" ;
    dcterms:description "Quand Aquaman mandate un avocat externe (cabinet, avocat indépendant, expert spécialisé), la sélection, le fee cap, et le performance review engagent un couplage opérationnel entre Aquaman (doctrine Legal) et Wonder Woman (doctrine Finance honoraires). Ce concept pose une grille de sélection en 5 critères, un fee cap en 3 paliers, un performance review trimestriel avec 3 indicateurs. 5 cas d'application légitime, 4 cas d'abus (panel shopping / fee creep / conflict override / panel lock-in), 4 issues de fin d'engagement. Étend le couplage Aquaman ↔ Wonder Woman posé dans [[aquaman-couplages-invisibles]]." ;
    aspace:okfVersion "0.2" ;
