<urn:aspace:concept:pulse-domaines:wonder-woman-finance-jtbd-emit-receive>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//wonder-woman//wonder-woman-finance-jtbd-emit-receive.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Domaine Finance — paquets JTBD émis et reçus entre B2 (Wonder Woman) et B3 (Thunderbolts)" ;
    dcterms:description "Le contrat bilatéral B2 → B3 Finance suit le gabarit canonique (B2-FINANCE-YYYY-NN pour les Rocks, B3-FINANCE-YYYY-NN pour les JTBD). Wonder Woman émet principalement vers B3 Thunderbolts (MRR reconciliation, margin analysis, cost hunt, compliance, reporting). Elle reçoit de B3 lespreuves (capture/log/métrique/témoignage) via les 4 formes canoniques. Trois failure modes typiques Finance : scope creep sur les \"reports complets\", silent rework sur les réconciliations, escalade tardive sur les runway <6 mois." ;
    aspace:okfVersion "0.2" ;
