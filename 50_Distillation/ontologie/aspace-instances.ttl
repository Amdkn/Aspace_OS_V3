<urn:aspace:concept:pulse-domaines:green-lantern-people-couplages-invisibles>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-couplages-invisibles.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "People — sept couplages invisibles avec les autres domaines" ;
    dcterms:description "People (Green Lantern) est le domaine le plus transverse — il touche les sept autres domaines B2 par des couplages qui ne sont pas tous explicites dans la matrice d'harmonisation canonique. Trois couplages sont canoniques (charge People × Ops, ownership vacant × tous, succession × tous). Quatre couplages sont reconstruits depuis la pratique et le triplet v3 : People × IT (skills L0), People × Legal (double signature), People × Finance (charge comme coût récurrent), People × Growth (rotation vs continuité de la marque)." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "people" ;
    aspace:tag "green-lantern" ;
    aspace:tag "couplages" ;
    aspace:tag "invisibles" ;
