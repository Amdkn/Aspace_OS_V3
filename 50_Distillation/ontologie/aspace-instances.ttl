<urn:aspace:concept:pulse-domaines:cyborg-collision-numerotation-3-systemes-org-json>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//cyborg//cyborg-collision-numerotation-3-systemes-org-json.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Collision numérotation 3-systemes — ORG.json, Avengers Wheel, agent_canon" ;
    dcterms:description "ORG.json, Avengers Wheel et le slug agent_canon utilisent trois numérotations incompatibles des 8 capitaines B2. Cyborg passe de 05 (Avengers Wheel) à 7 (ORG.json) à 06 (agent_canon) à 07_RD_et_IT (dossier). 5 capitaines sur 8 ont une collision. Le concept pose une table de correspondance et un protocole de résolution." ;
