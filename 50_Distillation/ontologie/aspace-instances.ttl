<urn:aspace:concept:pulse-domaines:flash-doctrine-valeur-artefact>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//flash//flash-doctrine-valeur-artefact.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Flash Product — la doctrine « valeur d'artefact », contraste avec les 3 autres docteurs" ;
    dcterms:description "Le triplet v3 ligne 17 et la doctrine Batman décrivent Flash comme « parlant en valeur d'artefact ». C'est la 4ᵉ des 4 unités de parole canoniques B2 : Batman Ops = état, Superman Growth = promesse, Wonder Woman Finance = retour, Flash Product = valeur d'artefact. La doctrine n'est pas qu'un style — elle conditionne ce que Flash peut bloquer sans escalader (contrairement à Batman), et ce que son veto catalogue protège (la survie de l'artefact hors de son opérateur)." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "flash" ;
    aspace:tag "product" ;
    aspace:tag "doctrine" ;
