<urn:aspace:concept:pulse-domaines:superman-veto-empirical-validation-protocole>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//superman//superman-veto-empirical-validation-protocole.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Superman veto — protocole de validation empirique (cible 3 cas / 60 jours)" ;
    dcterms:description "Le veto Superman est projeté par lecture critique du canon (cf. veto-catalogue-concrete.md), pas observé en cycle réel. La doctrine canonique exige des vetos \"vérifiables\" et \"catégoriels\" — deux propriétés qui ne peuvent être confirmées qu'en cycle. Ce concept pose un protocole de validation empirique : 3 cas observés sur 60 jours, packet mésoperpétuel type par cas, 5 critères d'acceptance, 3 indicateurs de couverture/distribution/vitesse, 3 conditions de mise à jour doctrine." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "superman" ;
    aspace:tag "growth" ;
