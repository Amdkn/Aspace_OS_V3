<urn:aspace:concept:pulse-domaines:superman-dod-attention-procedure-canon>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//superman//superman-dod-attention-procedure-canon.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Superman Growth — procédure canonique de fixation du DoD attention par mandat B1" ;
    dcterms:description "La question ouverte \"DoD attention mesurable\" (cf. superman-5-questions-ouvertes-cloture.md §Question 4) n'a pas été tranchée en vague 2 — la vague 3 la ferme par une procédure canonique en 5 étapes : (1) mandat B1 propose un scope, (2) Superman propose 3 DoDs candidats (MQL/conversion/reach), (3) JohnJones arbitre le DoD final, (4) Council tranche en désaccord, (5) DoD chiffré par seuil verrouillé. Le DoD attention est mandat-spécifique, pas canon." ;
    aspace:okfVersion "0.2" ;
