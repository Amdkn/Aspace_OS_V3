<urn:aspace:concept:pulse-domaines:aquaman-veto-amendment-perimetre-insuffisant>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//aquaman//aquaman-veto-amendment-perimetre-insuffisant.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Aquaman — deux amplifications candidates pour le veto engagement-sans-périmètre" ;
    dcterms:description "Le veto canonique Aquaman bloque les prestations « sans accord écrit sur le périmètre et la propriété du livrable ». Deux cas-limite restent non couverts : (1) périmètre écrit mais insuffisant, (2) propriété intellectuelle non déclarée. Deux amplifications candidates proposées, chacune avec un packet d'observation documentée, un draft en une phrase, et la procédure d'adoption par le Council (majorité simple 5/8 + D4 append-only). Tour 3 transforme la friction ouverte depuis tour 1 en deux propositions concrètes." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b2" ;
    aspace:tag "aquaman" ;
    aspace:tag "veto" ;
