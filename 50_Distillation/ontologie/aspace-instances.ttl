<urn:aspace:concept:pulse-domaines:green-lantern-people-perimetre-frontieres>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-perimetre-frontieres.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "People (Green Lantern / X-Men) — périmètre et trois frontières floues" ;
    dcterms:description "Le périmètre People canon V4 = People (domaine 07), B2 captain Green Lantern, B3 squad X-Men. Trois frontières contestées : avec IT Cyborg (tech-recruiting vs IT infra), avec Legal Aquaman (contrats de travail), avec Batman Ops (rotation de charge sur la livraison). Frontière canon = \"qui tient le mandat de recrutement, qui tient la propriété de l'agent\"." ;
    aspace:okfVersion "0.2" ;
