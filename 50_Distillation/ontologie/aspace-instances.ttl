<urn:aspace:concept:pulse-domaines:green-lantern-people-8-veto-scope-standardization-doctrine>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-8-veto-scope-standardization-doctrine.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Green Lantern People — Doctrine 8-veto scope standardization (R8 méta)" ;
    dcterms:description "Le rapport tour 5 R8 a observé une **asymétrie structurelle** entre le veto People (mandat + critère de sortie, scope = agent) et les 7 autres vetos (scope = procédure / produit / Sales / promesse / dépense / IT / prestation). Le présent concept **formalise** cette asymétrie en doctrine 8-veto scope standardization avec 4 catégories d'objet + 3 niveaux de test canonique + matrice 8×3. Council-ready draft avec 3 conditions saisissabilité." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "people" ;
    aspace:tag "green-lantern" ;
    aspace:tag "8-veto" ;
    aspace:tag "scope" ;
    aspace:tag "standardization" ;
