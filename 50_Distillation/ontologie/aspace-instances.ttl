<urn:aspace:concept:pulse-domaines:batman-cycle-vie-procedure-ops-cinq-phases>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-cycle-vie-procedure-ops-cinq-phases.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Cycle de vie d'une procédure Ops — 5 phases de la conception à l'arrêt" ;
    dcterms:description "Le rapport tour 1 a signalé un trou canonique : la durée d'une procédure Ops n'est pas posée (mensuelle, trimestrielle, 12WY ?). Le concept `batman-stop-condition-typologie-quatre-formes` a posé 4 formes de condition d'arrêt. Ce concept complète en posant un cycle de vie en 5 phases — conception, pilote, production, revue, arrêt — qui aligne la durée Ops sur le cycle 12WY de Summers et donne une grille de lecture pour chaque condition d'arrêt." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "batman" ;
    aspace:tag "ops" ;
