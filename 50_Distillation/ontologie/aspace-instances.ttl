<urn:aspace:concept:pulse-domaines:cooperation-mode-patterns>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//superman//cooperation-mode-patterns.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Superman Growth — patterns de coopération parallel / handoff / negotiation" ;
    dcterms:description "Superman Growth entre en parallel (40% des cas), handoff (40%), et negotiation (20%) — projection par lecture de la matrice d'harmonisation. Les pair-checks #5 (Finance→Growth) et #7 (Legal→Growth) sont presque toujours handoff. Le pair-check #1 (Growth→Sales) alterne parallel et negotiation selon la stabilité de l'ICP. Superman entre rarement en escalation B1 — sauf quand le veto canonique tient face à un mandat B1." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "superman" ;
