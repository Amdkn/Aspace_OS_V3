<urn:aspace:concept:pulse-domaines:green-lantern-people-xmen-squad-lead-nomination-procedure>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-xmen-squad-lead-nomination-procedure.md" ;
