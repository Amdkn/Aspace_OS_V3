<urn:aspace:concept:pulse-b3:b3-cycle-scrums-five-per-week>
    a aspace:Concept ;
    aspace:bundle "pulse/b3" ;
    aspace:fichier "70_Onthologies//pulse//b3//b3-cycle-scrums-five-per-week.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "B3 cycle — 5 scrums par semaine, une action exécutable par jour ouvré" ;
    dcterms:description "La cadence B3 canonique : 5 scrums/semaine (un par jour ouvré), pas une moyenne, pas un sprint. Chaque Scrum = une action exécutable qui dépend d'un sprint B2 qui dépend d'un rock B1. Le Scrum ne se confond pas avec le ticket, ni avec le rapport. C'est le grain minimal de traçabilité B3." ;
    aspace:okfVersion "0.2" ;
