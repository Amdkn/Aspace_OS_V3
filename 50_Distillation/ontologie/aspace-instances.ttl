<urn:aspace:concept:pulse-domaines:domain-perimeter>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//superman//domain-perimeter.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Périmètre du domaine Superman — Growth (01) et ses trois frontières floues" ;
    dcterms:description "Superman Growth (01) couvre l'attention, le signal de marché, et la qualification amont de la demande. Trois frontières ne sont pas scellées dans le canon : (a) Superman vs Sales — qui transforme l'attention en opportunité qualifiée, (b) Superman vs Brand/People — qui tient le récit de long terme, (c) Superman vs IT — qui tient la mesure analytics. Chaque frontière produit un arbitrage B2 Council prévisible." ;
    aspace:okfVersion "0.2" ;
