<urn:aspace:concept:pulse-domaines:cyborg-jtbd-emit-receive-kang-dynasty>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//cyborg//cyborg-jtbd-emit-receive-kang-dynasty.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Cyborg — paquets JTBD émis vers Kang Dynasty et reçus des domaines amont" ;
    dcterms:description "Cyborg émet vers la squad Kang Dynasty des JTBD packets bornés par le Rock→DoD→JTBD pipeline (5 étapes, autonomy contract, peer unlock rule). Il reçoit en amont des pair-checks #3 Product→IT (Flash), #5 Finance→Growth (Wonder Woman sur coût d'infra) et indirectement #9 People→Tous (charge). Six formes de paquets canoniques observées, trois failure modes si le paquet est trop vague." ;
    aspace:okfVersion "0.2" ;
