    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//john-jones//johnjones-jtbd-emit-receive.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "JohnJones — paquets JTBD émis vers B3 Illuminati et reçus des autres domaines" ;
    dcterms:description "JohnJones émet des JTBD packets vers B3 Illuminati (charges BlackBolt Closer, IronMan Demo, MrFantastic Discovery, Namor Negotiation, ProfessorX BuyerRead, DoctorStrange Forecasting). Il reçoit des JTBD de Growth (MQL/data), de Product (promesse/shape de l'offre), de Finance (prix/marge), de Legal (terms/claims safe), et de People (charge/ownership). Le contrat bilatéral B2 → B3 (cf. b2-b3-jtbd-handoff-contract) impose une double signature et un DoD chiffré." ;
