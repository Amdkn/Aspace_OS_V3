    rdfs:label "Pourquoi 11 classes, pas une seule — la décomposition d'« aspace:Concept »" .

<urn:aspace:concept:ontologie:_concepts_ontologie_namespace>
    a aspace:Concept ;
    aspace:bundle "ontologie" ;
    aspace:fichier "50_Distillation//ontologie//_concepts_ontologie_namespace.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Pourquoi urn:aspace:ns: — un namespace qui ne prétend rien" ;
    dcterms:description "Le namespace de l'ontologie est urn:aspace:ns: — pas https://aspace-os.org/. C'est un choix delibere : inventer un domaine HTTP risquerait de s'approprier un domaine detenu par un tiers et de poser une adresse qui ne resout pas. Le piege placeholder.invalid a deja ete paye sur ce poste. Un namespace URN est un nom, pas une promesse de resolution." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "ontologie" ;
    aspace:tag "namespace" ;
    aspace:tag "iri" ;
    aspace:tag "urn" ;
    aspace:tag "semantique" ;
