<urn:aspace:concept:pulse-domaines:batman-doctrine-remonte-fait-non-decision>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-doctrine-remonte-fait-non-decision.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Batman — la doctrine remonte-fait, pas décision" ;
    dcterms:description "Batman ne statue pas. Il porte les faits au B1 (Summers) avec leur motif. Deux triplets (56, 57) ancrent cette doctrine : tout fait Ops doit être posé comme un constat vérifiable, et le veto lui-même remonte comme un fait. Conséquence : la séparation Batman/Summers est la même que la séparation observateur/arbitre — Batman est le Captain qui observe, Summers est celui qui tranche." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "doctrine" ;
    aspace:tag "batman" ;
    aspace:tag "ops" ;
    aspace:tag "fait" ;
    aspace:tag "decision" ;
    aspace:tag "summers" ;
    aspace:tag "b1" ;
    aspace:tag "separation" ;
    aspace:niveauConfiance aspace:confirmeMachine ;
    aspace:generePar "minimax-m3" ;
    aspace:verifiePar "process:lecture-b2-corpus" ;
