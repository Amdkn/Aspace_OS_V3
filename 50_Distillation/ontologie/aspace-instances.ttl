<urn:aspace:concept:pulse-domaines:batman-stop-condition-typologie-quatre-formes>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-stop-condition-typologie-quatre-formes.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Batman — typologie des quatre formes canoniques de condition d'arrêt" ;
    dcterms:description "Le veto Batman (procédure sans condition d'arrêt écrite) exige une forme opérable. Sans typologie, la condition d'arrêt est invérifiable — la propriété « vérifiable » du catalogue 8-vetos n'est pas tenable. Quatre formes canoniques : date+métrique, événement+métrique, owner+escalade, réversibilité. Chaque forme a un cas d'usage nominal, deux cas limites où elle devient abusive, et un couplage avec un autre veto catalogue." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "batman" ;
    aspace:tag "condition-arret" ;
    aspace:tag "typologie" ;
