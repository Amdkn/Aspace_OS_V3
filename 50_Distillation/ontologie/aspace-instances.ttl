<urn:aspace:concept:pulse-domaines:green-lantern-people-lag-indicator-succession>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//green-lantern//green-lantern-people-lag-indicator-succession.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "People — lag indicator succession, taux et qualité de transition" ;
    dcterms:description "Le délai de succession est un lag indicator People non posé dans le canon V4. Le concept propose trois indicateurs mesurables (délai median, taux de succession bouclée en ≤ N jours, qualité de transition mesurée par taux de rollback à 90 jours), avec des seuils différenciés par type de mandat (humain vs agent, junior vs senior, owner de marque vs owner de production). Format de remontée hebdomadaire, audit mensuel, et règle d'escalade si un lag franchit son seuil d'alerte." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "people" ;
    aspace:tag "green-lantern" ;
    aspace:tag "lag-indicator" ;
