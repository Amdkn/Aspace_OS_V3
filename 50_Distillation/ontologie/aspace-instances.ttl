<urn:aspace:concept:pulse-domaines:flash-pair-check-growth-product-candidate-v5>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//flash//flash-pair-check-growth-product-candidate-v5.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Flash — pair-check Growth → Product candidat V5" ;
    dcterms:description "Le couplage indirect Growth → Product est le dernier des 4 non-canoniques encore ouvert (cf. RAPPORT_dom-flash.md §5.2). Quand Superman signale un besoin ICP/persona sans scope formalisé, Flash reçoit en NEEDS_SCOPE. Sans matrice canonique, le B2 Council n'a pas de mécanisme pour bloquer le lancement d'un produit sans validation Growth. Ce concept propose l'amendement matrice V5 avec RACI Flash A / Superman C + 3 cas légitimes + 3 cas abusifs." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "flash" ;
    aspace:tag "growth" ;
    aspace:tag "product" ;
    aspace:tag "pair-check" ;
    aspace:tag "growth-product" ;
