<urn:aspace:concept:pulse-domaines:johnjones-lead-to-cash-cycle-doctrine-discipline-flux-financement>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//john-jones//johnjones-lead-to-cash-cycle-doctrine-discipline-flux-financement.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Lead-to-cash cycle — discipline du flux financement MQL→cash, miroir Sales de la doctrine CCC Wonder Woman F26" ;
    dcterms:description "Doctrine canonique du cycle lead-to-cash qui étend le pipeline 5 états (concept 1 Tour 6) jusqu'au cash encaissé. 4 phases (pré-cash MQL→SQL→OPP≤60j, conversion OPP→CW→invoice≤30j, cash-collection CW→cash≤30j, post-cash renewal H730) avec 5 outils canoniques (pipeline-stage/devis/facture/encaissement/renewal-flag), 4 indicateurs lead-to-cash (cash-conversion-cycle Sales ≤ 90j, ARR/MQL ratio ≥ $500, OPP-to-cash ≤ 75j, CW-to-cash ≤ 30j) et couplage bilatéral Wonder Woman F1-F25 (CCC F26 Wonder Woman est le miroir Finance — Sales joue la phase pré-cash et le levier upstream). Ferme le trou 5 vagues : Sales a 0 doctrine sur le cash, alors que la transition OPP→CW→cash→renewal est Sales-side." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "sales" ;
