<urn:aspace:concept:pulse-b2:b2-council-cadence-and-chair>
    a aspace:Concept ;
    aspace:bundle "pulse/b2" ;
    aspace:fichier "70_Onthologies//pulse//b2//b2-council-cadence-and-chair.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "B2 Council — cadence, présidence tournante, et mécanique de séance" ;
    dcterms:description "Le B2 Council tient trois types de séances : hebdomadaire pendant les cycles de build actif (sprint du lundi), ad hoc sur veto ou red flag matrice, et bilan en fin de 12WY. La présidence est tournante par impacted captain — pas de président permanent. Le journal Council est append-only D4 ; le quorum est de 5 capitaines sur 8. La cadence est dérivée du cycle sprint hebdo des VP (triplet 10)." ;
    aspace:okfVersion "0.2" ;
