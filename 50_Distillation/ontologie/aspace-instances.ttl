<urn:aspace:concept:pulse-domaines:batman-pyramide-l0-l1-l2-positionnement>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-pyramide-l0-l1-l2-positionnement.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Positionnement Batman dans la pyramide L0 ≥ L1 > L2 — canal de remontée Summers" ;
    dcterms:description "Le triplet 39 pose la pyramide L0 ≥ L1 > L2 (SDD-006 §1.1:59) avec L0 = autorité absolue, L1 = veto Beth, L2 = exécution dans les bornes. Batman est B2 captain, ce qui le place à un rang non couvert explicitement par la pyramide. Le concept réconcilie la pyramide canonique avec la doctrine remonte-fait (triplets 56/57) en positionnant Batman en L2 opérationnel avec canal de remontée Summers = L1 décision cycle. La distinction ferme un trou ouvert depuis le tour 1 sur le canal de remontée." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b2" ;
