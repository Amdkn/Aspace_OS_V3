<urn:aspace:concept:pulse-b2:b2-pair-check-raci-by-rank>
    a aspace:Concept ;
    aspace:bundle "pulse/b2" ;
    aspace:fichier "70_Onthologies//pulse//b2//b2-pair-check-raci-by-rank.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "RACI par rang sur les 9 pair-checks — qui est Accountable quand deux domaines se croisent" ;
    dcterms:description "Le rapport tour 2 a refusé un RACI par pair-check comme trop spéculatif. Lu en intégralité, le triplet v3 (7, 8, 13, 41, 56, 57) ancre un RACI par rang (B1/B2/B3), pas par personne. Pour chaque transition, B2 en aval est Accountable, B2 en amont est Consulted, B1 est Informed, B3 est Responsible. Le RACI par rang est plus court à tenir qu'un RACI par personne, et ne dérive pas quand un capitaine change." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b2" ;
    aspace:tag "raci" ;
    aspace:tag "rang" ;
