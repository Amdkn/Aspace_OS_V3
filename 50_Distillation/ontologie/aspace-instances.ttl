<urn:aspace:concept:ontologie:_concepts_ontologie_modele>
    a aspace:Concept ;
    aspace:bundle "ontologie" ;
    aspace:fichier "50_Distillation//ontologie//_concepts_ontologie_modele.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Pourquoi 11 classes, pas une seule — la décomposition d'« aspace:Concept »" ;
    dcterms:description "Le constat mesure : 62/95 concepts sont kind:Concept, ce qui transforme la classe en fourre-tout. La décomposition proposée distingue les concepts par engagement (Doctrine/Decision/Playbook/Pattern) et isole les artefacts (Project/Backend/Archive/Event/Relation) et les personas des concepts purs." ;
