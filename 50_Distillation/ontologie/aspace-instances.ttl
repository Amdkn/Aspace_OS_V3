<urn:aspace:concept:pulse-domaines:batman-asymetrie-amplification-canonique-vs-wonder-woman-procedure-par-accumulation>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//batman//batman-asymetrie-amplification-canonique-vs-wonder-woman-procedure-par-accumulation.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Asymétrie amplification Wonder Woman (triplet 58) vs Batman — procédure par accumulation" ;
    dcterms:description "Le triplet 58 dit *« Wonder Woman étend la doctrine veto-dépense : corrélat direct avec la dette récurrente — chaque ligne doit porter une métrique de retour chiffrée »*. Wonder Woman peut amplifier sa doctrine veto. Batman n'a pas d'équivalent canonique — pour durcir son veto, il doit escalader B1 (triplets 56/57). Le rapport §T5.5.2.P a documenté l'asymétrie sans la résoudre. Ce concept propose une procédure d'amplification Batman par accumulation : 3 vetoiseurs sur la même classe = amplification proposée au Council." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "batman" ;
    aspace:tag "wonder-woman" ;
