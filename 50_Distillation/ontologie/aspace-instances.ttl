<urn:aspace:concept:pulse-domaines:wonder-woman-vendor-concentration-risk-doctrine>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//wonder-woman//wonder-woman-vendor-concentration-risk-doctrine.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Vendor concentration risk — single vendor > 30% opex, doctrine 3 seuils + couplage Cyborg/Aquaman" ;
    dcterms:description "Quand un fournisseur unique représente > 30% de l'OPEX (operating expenses), la position de l'entreprise devient asymétrique : une rupture de service, une hausse de prix, ou une faillite fournisseur peut anéantir l'opération. La doctrine Finance WW pose 3 seuils (warning 30%, escalation 50%, hard veto 70%), couplés à Cyborg (IT) pour la souveraineté infra et Aquaman (Legal) pour les clauses de sortie. L'asymétrie Cyborg §05 (bloque cloud-only sans chemin de sortie) protège le risque opérationnel ; WW protège le risque financier." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "wonder-woman" ;
    aspace:tag "finance" ;
    aspace:tag "vendor-concentration" ;
    aspace:tag "risque" ;
    aspace:tag "cyborg" ;
    aspace:tag "aquaman" ;
    aspace:tag "opex" ;
    aspace:tag "seuils" ;
    aspace:tag "doctrine" ;
    aspace:niveauConfiance aspace:confirmeMachine ;
    aspace:generePar "minimax-m3" ;
    aspace:verifiePar "process:lecture-corpus-tour-6" ;
    dcterms:source "C:/Users/amado/ASpace_OS_V3/70_Onthologies/pulse/b2/b2-eight-domain-vetoes-catalogue.md" ;
    dcterms:source "C:/Users/amado/ASpace_OS_V3/70_Onthologies/pulse/domaines/wonder-woman/wonder-woman-f24-sovereign-infra-arbitrage-doctrine.md" ;
    dcterms:source "C:/Users/amado/ASpace_OS_V3/70_Onthologies/pulse/domaines/wonder-woman/wonder-woman-finance-couplings.md" ;
    dcterms:source "C:/Users/amado/ASpace_OS_V3/70_Onthologies/pulse/domaines/wonder-woman/wonder-woman-aquaman-dormant-casse-triangulaire.md" ;
