<urn:aspace:concept:pulse-domaines:superman-mql-sql-handoff-contract>
    a aspace:Concept ;
    aspace:bundle "pulse/domaines" ;
    aspace:fichier "70_Onthologies//pulse//domaines//superman//superman-mql-sql-handoff-contract.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Superman Growth ↔ JohnJones Sales — contrat bilatéral sur le pair-check #1 Growth → Sales" ;
    dcterms:description "Le pair-check #1 (Growth → Sales) est la transition la plus scrutée de la wheel. Superman produit le MQL, JohnJones transforme en SQL. Le contrat bilatéral pose trois Seuils de qualification partagée, quatre signals de friction, et la procédure de gel conjointe quand Sales est red (red flag #2). Le DoD MQL est co-signé par les deux captains — Superman ne qualifie pas seul, JohnJones ne rejette pas seul." ;
