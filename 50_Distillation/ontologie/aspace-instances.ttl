<urn:aspace:concept:pulse-b2:b2-veto-amplification-cycle>
    a aspace:Concept ;
    aspace:bundle "pulse/b2" ;
    aspace:fichier "70_Onthologies//pulse//b2//b2-veto-amplification-cycle.md" ;
    aspace:kind kind:Concept ;
    dcterms:title "Amplification des vetos B2 — le catalogue est vivant, pas figé" ;
    dcterms:description "Le triplet 58 dit « Wonder Woman étend sa doctrine veto-dépense : corrélat direct avec la dette récurrente — chaque ligne doit porter une métrique de retour chiffrée ». Le verbe « étend » implique que les 8 vetos catalogue (cf. b2-eight-domain-vetoes-catalogue) ne sont pas un inventaire clos. Une amplification ajoute une nouvelle classe de décision au veto, pas un cas nouveau à une classe existante. Trois conditions, une procédure d'amendement D4, un anti-piège sur la dérive." ;
    aspace:okfVersion "0.2" ;
    aspace:tag "b2" ;
