{
  "manifest_version": 3,
  "name": "A'Space Machine Fabric M1",
  "version": "1.0.0",
  "description": "Bounded Native Messaging + DOM agent for AMF M1.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "kick.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
