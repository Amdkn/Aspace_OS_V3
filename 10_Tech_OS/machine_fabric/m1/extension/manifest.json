{
  "manifest_version": 3,
  "name": "A'Space Machine Fabric M1",
  "version": "1.0.0",
  "description": "Production Bounded Native Messaging + DOM capability for AMF M1.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": "",
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "kick.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "debugger",
    "cookies"
  ]
}
