{
  "schema": "aspace.factory-blueprint.v1",
  "factory_id": "AMF-MACHINE-FABRIC",
  "version": "0.1.0",
  "origin": "GitHub #194/#195/#196",
  "trigger_schema": {
    "kind": "typed_machine_operation",
    "required": ["capability", "operation_id", "authority", "precondition"]
  },
  "input_contract": {
    "operation": "aspace.machine.operation.v1",
    "capability_manifest": "aspace.machine.capability-manifest.v1",
    "policy_request": "aspace.machine.policy-request.v1"
  },
  "output_contract": {
    "receipt": "aspace.machine.receipt.v1",
    "health": "aspace.machine.health.v1",
    "failure": "aspace.machine.failure.v1"
  },
  "system1_rules": [
    {"rule": "same operation_id + same fingerprint returns prior terminal receipt without re-executing effect"},
    {"rule": "same operation_id + different fingerprint is rejected as conflict"},
    {"rule": "policy evaluates before every consequential adapter effect, including interactive process follow-ups"},
    {"rule": "daemon alive + required worker unavailable => DEGRADED, never ONLINE"},
    {"rule": "debugger/CDP authority is separate from DOM/accessibility authority"},
    {"rule": "transport reconnect never creates a new operation identity"},
    {"rule": "retry is allowed only for operations whose replay policy declares it safe"}
  ],
  "escalation_policy": {
    "system2_targets": ["doctor13-kernel", "rick"],
    "escalate_on": [
      "semantic policy ambiguity",
      "irreversible effect without explicit approval",
      "operation identity conflict",
      "capability authority widening",
      "receipt/effect divergence"
    ]
  },
  "authority": {
    "allowed": [
      "loopback daemon",
      "signed-in user worker",
      "typed adapters",
      "private remote overlay",
      "durable local receipts",
      "bounded reversible compensation"
    ],
    "forbidden": [
      "public internet bind by default",
      "raw cookie export",
      "silent debugger escalation",
      "transport as execution truth",
      "blind replay of unknown mutation",
      "adapter-specific authority bypass"
    ],
    "reversible_only": false,
    "requires_human_approval": [
      "irreversible filesystem/process/browser mutation outside pre-approved class",
      "debugger/runtime evaluation",
      "authority expansion",
      "public exposure"
    ]
  },
  "side_effects": {
    "sequence": ["capability", "policy", "operation_id", "precondition", "effect", "receipt", "replay_or_compensation"],
    "ledger_first": true,
    "effect_requires_claim": true
  },
  "evidence_contract": {
    "required": ["operation_id", "capability", "adapter", "policy_decision", "started_at", "finished_at", "effect_digest", "receipt_state"],
    "addressable": true,
    "provenance_owner": "Graham",
    "behavior_observer": "Yaz"
  },
  "rollback_retry_dlq": {
    "retry_owner": "Nardole",
    "dlq_owner": "Donna",
    "coherence_owner": "Rory",
    "retry_requires": ["same_operation_id", "known_replay_class", "no_terminal_success_receipt"],
    "compensation_requires": ["explicit compensation contract", "evidence link"]
  },
  "observability_yaz": {
    "metrics": ["latency", "failure_rate", "duplicate_prevention", "worker_reconnects", "policy_denials", "adapter_health"]
  },
  "state_graham": {
    "stores": ["operation ledger", "receipt provenance", "capability manifest version", "policy version"]
  },
  "dispatch_nardole": {
    "routes_by": ["capability", "authority", "worker availability", "adapter health", "risk class"],
    "never_routes_by": ["Companion identity alone", "UI session alone"]
  },
  "build_ryan": {
    "mvp": "10_Tech_OS/machine_fabric/mvp/RYAN_BUILD_PACKET.md",
    "fundamental_canary": "mutation -> crash/restart -> replay -> zero duplicate mutation"
  },
  "interface_amy": {
    "presents": ["health", "worker presence", "approval request", "receipt", "degraded reason"]
  },
  "flow_river": {
    "automation_rule": "webhook first, cron second, agent last"
  },
  "coherence_rory": {
    "invariants": ["no false online", "no double claim", "no authority drift", "receipt/effect consistency"]
  },
  "compatibility": {
    "desktop_commander": "adapter/reference, not architecture",
    "windows_mcp": "optional UI adapter",
    "playwright_mcp": "semantic browser adapter",
    "chrome_devtools_mcp": "privileged debugger adapter",
    "tailscale_serve": "private remote canary v0",
    "headscale_wireguard": "sovereignty candidate, separate certification"
  }
}
