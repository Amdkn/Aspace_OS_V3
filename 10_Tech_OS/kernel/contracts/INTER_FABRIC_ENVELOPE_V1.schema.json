{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aspace://inter-fabric-envelope/v1",
  "title": "A'Space InterFabric Envelope v1",
  "description": "Minimal cross-cutting envelope for multi-fabric transport. It preserves identity, mission lineage, authority, resource/effect coordinates, evidence and return routing without becoming a semantic authority.",
  "type": "object",
  "required": [
    "identity",
    "mission",
    "capability",
    "authority",
    "resource",
    "effect",
    "truth",
    "routing",
    "compatibility",
    "payload"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["holon_id", "institutional_rank"],
      "properties": {
        "holon_id": { "type": "string", "minLength": 1 },
        "institutional_rank": { "type": "string", "minLength": 1 },
        "embodiment_ref": { "type": ["string", "null"] },
        "session_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "required": ["mission_id", "work_id", "cell_id", "correlation_id"],
      "properties": {
        "mission_id": { "type": "string", "minLength": 1 },
        "work_id": { "type": ["string", "integer"] },
        "cell_id": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "parent_correlation_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": ["object", "null"],
      "required": ["capability_id", "capability_version"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "capability_version": { "type": "string", "minLength": 1 },
        "contract_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["authority_scope", "policy_ref"],
      "properties": {
        "authority_scope": { "type": "string", "minLength": 1 },
        "policy_ref": { "type": "string", "minLength": 1 },
        "policy_version": { "type": ["string", "null"] },
        "mutation_lease": { "type": ["string", "null"] },
        "fencing_key": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": ["object", "null"],
      "properties": {
        "resource_lease_ref": { "type": ["string", "null"] },
        "budget_lease_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": ["object", "null"],
      "required": ["operation_id", "effect_class", "idempotency_key"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "effect_id": { "type": ["string", "null"] },
        "effect_class": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "replay_semantics": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "truth": {
      "type": "object",
      "required": [
        "evidence_refs",
        "observed_at",
        "source_authority",
        "freshness",
        "epistemic_state"
      ],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_authority": { "type": "string", "minLength": 1 },
        "freshness": {
          "type": "string",
          "enum": ["FRESH", "STALE", "UNKNOWN"],
          "description": "Freshness is orthogonal to epistemic truth; UNKNOWN freshness must not be coerced into a truth claim."
        },
        "epistemic_state": {
          "type": "string",
          "enum": ["KNOWN", "UNKNOWN", "CONTRADICTED"]
        },
        "age_seconds": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["origin_layer", "return_to"],
      "properties": {
        "origin_layer": { "type": "string", "minLength": 1 },
        "return_to": { "type": "string", "minLength": 1 },
        "blocked_outcome": { "type": ["string", "null"] },
        "recovery_hint": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "envelope_version",
        "payload_schema",
        "payload_version",
        "lossy_fields"
      ],
      "properties": {
        "envelope_version": { "type": "string", "const": "v1" },
        "payload_schema": { "type": "string", "minLength": 1 },
        "payload_version": { "type": "string", "minLength": 1 },
        "lossy_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "description": "Fabric-specific meaning. Transport invariants live outside this payload.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
