{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aspace://temporal-truth-context/v1",
  "title": "A'Space Temporal Truth and Context Contracts v1",
  "$defs": {
    "EvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "TemporalState": {
      "enum": [
        "CURRENT",
        "HISTORICAL",
        "SUPERSEDED",
        "CONTRADICTED",
        "EXPERIMENTAL",
        "PROPOSED",
        "UNKNOWN"
      ]
    },
    "TemporalClaim": {
      "type": "object",
      "required": [
        "schema",
        "claim_id",
        "source_ref",
        "observed_at",
        "scope",
        "assertion",
        "evidence_refs",
        "temporal_state"
      ],
      "properties": {
        "schema": {"const": "aspace.temporal-claim.v1"},
        "claim_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "correlation_id": {"type": ["string", "null"]},
        "observed_at": {"type": "string"},
        "valid_from": {"type": ["string", "null"]},
        "valid_to": {"type": ["string", "null"]},
        "scope": {"type": "string", "minLength": 1},
        "subject": {"type": ["string", "null"]},
        "assertion": {},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/EvidenceRef"}
        },
        "temporal_state": {"$ref": "#/$defs/TemporalState"},
        "supersedes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "superseded_by": {
          "type": "array",
          "items": {"type": "string"}
        },
        "contradicts": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "CanonTransition": {
      "type": "object",
      "required": [
        "schema",
        "transition_id",
        "subject",
        "scope",
        "from_claims",
        "to_claims",
        "effective_at",
        "reason",
        "evidence_refs",
        "resolution_authority"
      ],
      "properties": {
        "schema": {"const": "aspace.canon-transition.v1"},
        "transition_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "from_claims": {"type": "array", "items": {"type": "string"}},
        "to_claims": {"type": "array", "items": {"type": "string"}},
        "effective_at": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/EvidenceRef"}
        },
        "resolution_authority": {"type": "string", "minLength": 1},
        "contradiction_refs": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "ContextCapsule": {
      "type": "object",
      "required": [
        "schema",
        "capsule_id",
        "compiled_at",
        "holon_id",
        "mission_id",
        "correlation_id",
        "canon_slice",
        "anthology_window",
        "authority_envelope",
        "workgraph_neighborhood",
        "evidence_head",
        "contradictions",
        "unknowns",
        "return_to"
      ],
      "properties": {
        "schema": {"const": "aspace.context-capsule.v1"},
        "capsule_id": {"type": "string", "minLength": 1},
        "compiled_at": {"type": "string"},
        "holon_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1},
        "canon_slice": {"type": "array", "items": {"type": "string"}},
        "anthology_window": {"type": "array", "items": {"type": "string"}},
        "physiology_ref": {"type": ["string", "null"]},
        "authority_envelope": {"type": "object"},
        "workgraph_neighborhood": {"type": "object"},
        "source_slice": {"type": "object"},
        "evidence_head": {"type": "array", "items": {"type": "string"}},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "return_to": {"type": "object"}
      },
      "additionalProperties": false
    },
    "PhysiologyDimension": {
      "type": "object",
      "required": [
        "name",
        "value",
        "source_ref",
        "source_observed_at",
        "epistemic_state",
        "evidence_refs"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {},
        "source_ref": {"type": "string", "minLength": 1},
        "source_observed_at": {"type": "string"},
        "freshness": {"type": ["string", "number", "null"]},
        "epistemic_state": {"enum": ["KNOWN", "UNKNOWN", "CONTRADICTED", "STALE"]},
        "unknown_reason": {"type": ["string", "null"]},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/EvidenceRef"}
        }
      },
      "additionalProperties": false
    },
    "PhysiologySnapshot": {
      "type": "object",
      "required": ["schema", "snapshot_id", "observed_at", "dimensions"],
      "properties": {
        "schema": {"const": "aspace.physiology-snapshot.v1"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string"},
        "dimensions": {
          "type": "array",
          "items": {"$ref": "#/$defs/PhysiologyDimension"}
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/TemporalClaim"},
    {"$ref": "#/$defs/CanonTransition"},
    {"$ref": "#/$defs/ContextCapsule"},
    {"$ref": "#/$defs/PhysiologySnapshot"}
  ]
}